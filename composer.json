{
    "name": "maarheeze/compass",
    "description": "Repository and deployment status dashboard for GitHub and Laravel Forge",
    "keywords": [
        "laravel",
        "github",
        "forge",
        "dashboard"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.17",
        "laravel/socialite": "^5.31",
        "livewire/livewire": "^4.4",
        "maarheeze/uuid": "^3.0",
        "maarheeze/uuid-laravel": "^3.0",
        "webmozart/assert": "^2.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "maarheeze/guidelines": "^1.8",
        "maarheeze/phpcs": "^4.0",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Maarheeze\\Compass\\": "src/",
            "Maarheeze\\Compass\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maarheeze\\Compass\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpcbf": "vendor/bin/phpcbf -n",
        "phpcs": "vendor/bin/phpcs -n",
        "pest": "vendor/bin/pest --compact",
        "pest-coverage": "vendor/bin/pest --compact --coverage --min=100",
        "phpstan": "php vendor/bin/phpstan --memory-limit=-1",
        "phpstan-baseline": "php vendor/bin/phpstan --memory-limit=-1 --generate-baseline",
        "qa": [
            "@phpcs",
            "@phpstan",
            "@pest-coverage"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maarheeze\\Compass\\CompassServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
